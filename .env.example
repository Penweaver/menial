# Menial — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real secrets. §83

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# Payment Provider (abstracted — §37, §85)
# Use 'mock' during development. Eventually: 'paystack' or 'flutterwave'
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=

# ---------------------------------------------------------------------------
# SMS / OTP Provider (abstracted — §5, §85)
# Use 'mock' during development. Eventually: 'termii' or 'africas_talking'
# ---------------------------------------------------------------------------
SMS_PROVIDER=mock
# TERMII_API_KEY=
# AFRICAS_TALKING_API_KEY=
# AFRICAS_TALKING_USERNAME=

# ---------------------------------------------------------------------------
# Maps / Geocoding (abstracted — §76, §85)
# ---------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Push Notifications (abstracted — §50, §85)
# ---------------------------------------------------------------------------
# EXPO_PUSH_TOKEN=
